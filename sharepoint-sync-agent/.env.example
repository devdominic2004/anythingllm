# Azure App Registration Credentials (Client Credentials Flow)
AZURE_TENANT_ID=your_azure_tenant_id_here
AZURE_CLIENT_ID=your_azure_application_client_id_here
AZURE_CLIENT_SECRET=your_highly_confidential_client_secret_here

# Microsoft Graph API Base URL (Standard for M365 Commercial)
GRAPH_API_BASE=https://graph.microsoft.com/v1.0

# AnythingLLM Configuration
# Use your server's base URL (e.g., http://localhost:3001 or https://anythingllm.mycompany.com)
ANYTHINGLLM_URL=http://localhost:3001

# Provide an API key generated from AnythingLLM settings
ANYTHINGLLM_API_KEY=your_anythingllm_api_key_here

# Sync Configuration
SYNC_INTERVAL_MINUTES=15
MOCK_MODE=false
